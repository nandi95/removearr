# Tautulli — full API URL including /api/v2
TAUTULLI_API_KEY=
TAUTULLI_API_URL=https://tautulli.example.com/api/v2

# Radarr / Sonarr — full API URLs including /api/v3
RADARR_API_KEY=
RADARR_API_URL=https://radarr.example.com/api/v3
SONARR_API_KEY=
SONARR_API_URL=https://sonarr.example.com/api/v3

# Seerr — base URL, /api/v1 is appended
SEER_API_KEY=
SEER_URL=https://seerr.example.com

# Plex — used to maintain the "Leaving Soon" collection
PLEX_URL=https://plex.example.com
PLEX_SERVER_ID=
PLEX_SERVER_NAME=
PLEX_EMAIL=
PLEX_PASSWORD=
# PLEX_MOVIE_SECTION=Films

# Login — only the owner of PLEX_SERVER_ID can sign in. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Optional
DELETE_AFTER_DAYS=14
CRON_SCHEDULE=0 6 * * *
TZ=Europe/London
DEBUG=false
# PORT=8484
